// ProScreener: Support et Résistance Niveau 3 (Version Simplifiée)
// Détecte les niveaux testés 3 fois ou plus avec rebonds significatifs

// ============================================
// PARAMÈTRES
// ============================================
period = 50          // Période d'analyse
tolerance = 0.8      // Tolérance en % pour considérer un même niveau
minTests = 3         // Nombre minimum de tests du niveau
priceDistance = 3    // Distance max du prix au niveau (en %)

// ============================================
// DÉTECTION DES SUPPORTS (Niveau 3)
// ============================================

// Initialisation
supportFound = 0
supportPrice = 0
supportTests = 0

// Recherche du support le plus fort
for i = 10 to period do
    testPrice = low[i]
    tests = 0

    // Compter combien de fois ce niveau a été testé
    for j = 0 to period do
        if abs((low[j] - testPrice) / testPrice) * 100 < tolerance then
            tests = tests + 1
        endif
    next

    // Si niveau testé au moins minTests fois
    if tests >= minTests then
        supportFound = 1
        supportPrice = testPrice
        supportTests = tests
    endif
next

// Vérifier si le prix est proche du support
atSupport = 0
if supportFound = 1 then
    distToSupport = ((close - supportPrice) / supportPrice) * 100
    if distToSupport >= 0 and distToSupport <= priceDistance then
        atSupport = 1
    endif
endif

// ============================================
// DÉTECTION DES RÉSISTANCES (Niveau 3)
// ============================================

// Initialisation
resistanceFound = 0
resistancePrice = 0
resistanceTests = 0

// Recherche de la résistance la plus forte
for i = 10 to period do
    testPrice = high[i]
    tests = 0

    // Compter combien de fois ce niveau a été testé
    for j = 0 to period do
        if abs((high[j] - testPrice) / testPrice) * 100 < tolerance then
            tests = tests + 1
        endif
    next

    // Si niveau testé au moins minTests fois
    if tests >= minTests then
        resistanceFound = 1
        resistancePrice = testPrice
        resistanceTests = tests
    endif
next

// Vérifier si le prix est proche de la résistance
atResistance = 0
if resistanceFound = 1 then
    distToResistance = ((resistancePrice - close) / close) * 100
    if distToResistance >= 0 and distToResistance <= priceDistance then
        atResistance = 1
    endif
endif

// ============================================
// CONDITIONS DE FORCE
// ============================================

// Support fort avec volume
strongSupport = atSupport = 1 and volume > average[20](volume)

// Résistance forte avec volume
strongResistance = atResistance = 1 and volume > average[20](volume)

// Rebond récent sur support
bounceFromSupport = atSupport = 1 and close > open

// Rejet récent à la résistance
rejectedAtResistance = atResistance = 1 and close < open

// ============================================
// SCREENER
// ============================================

// Scanner les actions près d'un support ou résistance niveau 3
condition = (atSupport = 1) OR (atResistance = 1)

screener[condition] (supportPrice AS "Support", supportTests AS "Tests S", resistancePrice AS "Résistance", resistanceTests AS "Tests R", strongSupport AS "Support Fort", strongResistance AS "Resist Forte")
