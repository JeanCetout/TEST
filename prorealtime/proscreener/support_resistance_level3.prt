// ProScreener: Détection Support et Résistance Niveau 3
// Ce script identifie les supports et résistances de niveau 3
// (testés au moins 3 fois avec rebonds significatifs)

// ============================================
// PARAMÈTRES DE CONFIGURATION
// ============================================

// Période pour l'analyse des pivots
lookback = 20

// Tolérance pour considérer qu'un niveau est touché (en %)
tolerance = 0.5

// Nombre minimum de touches pour niveau 3
minTouches = 3

// Distance maximale du prix au niveau (en %)
maxDistance = 2

// Force du rebond minimum (en %)
minBounce = 1

// ============================================
// DÉTECTION DES PIVOTS HAUTS (Résistances)
// ============================================

// Détection d'un pivot haut
pivotHigh = 0
if high[lookback] = highest[lookback*2+1](high[lookback*2]) then
    pivotHigh = high[lookback]
endif

// ============================================
// DÉTECTION DES PIVOTS BAS (Supports)
// ============================================

// Détection d'un pivot bas
pivotLow = 0
if low[lookback] = lowest[lookback*2+1](low[lookback*2]) then
    pivotLow = low[lookback]
endif

// ============================================
// ANALYSE DES RÉSISTANCES NIVEAU 3
// ============================================

// Recherche de résistances testées plusieurs fois
resistanceLevel = 0
resistanceTouches = 0

// On analyse les 100 dernières barres pour trouver des niveaux de résistance
for i = 20 to 100 do
    if high[i] > 0 then
        testLevel = high[i]
        touches = 0
        totalBounce = 0

        // Compter les touches de ce niveau
        for j = 0 to 100 do
            upperBand = testLevel * (1 + tolerance/100)
            lowerBand = testLevel * (1 - tolerance/100)

            // Le prix a touché ce niveau
            if high[j] >= lowerBand and high[j] <= upperBand then
                touches = touches + 1

                // Calculer le rebond après la touche
                if j > 0 then
                    bounce = ((high[j] - low[j-1]) / high[j]) * 100
                    if bounce > minBounce then
                        totalBounce = totalBounce + bounce
                    endif
                endif
            endif
        next

        // Si ce niveau a été touché au moins minTouches fois
        if touches >= minTouches and totalBounce > 0 then
            resistanceLevel = testLevel
            resistanceTouches = touches
        endif
    endif
next

// Vérifier la proximité du prix à la résistance
nearResistance = 0
if resistanceLevel > 0 then
    distanceToResistance = ((resistanceLevel - close) / close) * 100
    if distanceToResistance >= 0 and distanceToResistance <= maxDistance then
        nearResistance = 1
    endif
endif

// ============================================
// ANALYSE DES SUPPORTS NIVEAU 3
// ============================================

// Recherche de supports testés plusieurs fois
supportLevel = 0
supportTouches = 0

// On analyse les 100 dernières barres pour trouver des niveaux de support
for i = 20 to 100 do
    if low[i] > 0 then
        testLevel = low[i]
        touches = 0
        totalBounce = 0

        // Compter les touches de ce niveau
        for j = 0 to 100 do
            upperBand = testLevel * (1 + tolerance/100)
            lowerBand = testLevel * (1 - tolerance/100)

            // Le prix a touché ce niveau
            if low[j] >= lowerBand and low[j] <= upperBand then
                touches = touches + 1

                // Calculer le rebond après la touche
                if j > 0 then
                    bounce = ((high[j+1] - low[j]) / low[j]) * 100
                    if bounce > minBounce then
                        totalBounce = totalBounce + bounce
                    endif
                endif
            endif
        next

        // Si ce niveau a été touché au moins minTouches fois
        if touches >= minTouches and totalBounce > 0 then
            supportLevel = testLevel
            supportTouches = touches
        endif
    endif
next

// Vérifier la proximité du prix au support
nearSupport = 0
if supportLevel > 0 then
    distanceToSupport = ((close - supportLevel) / close) * 100
    if distanceToSupport >= 0 and distanceToSupport <= maxDistance then
        nearSupport = 1
    endif
endif

// ============================================
// CRITÈRES DE SCREENER
// ============================================

// Condition 1: Support niveau 3 détecté et prix proche
condition1 = (supportLevel > 0) and (supportTouches >= minTouches) and (nearSupport = 1)

// Condition 2: Résistance niveau 3 détectée et prix proche
condition2 = (resistanceLevel > 0) and (resistanceTouches >= minTouches) and (nearResistance = 1)

// Condition 3: Volume confirmant (optionnel)
volumeConfirm = volume > average[20](volume) * 0.8

// ============================================
// RÉSULTAT DU SCREENER
// ============================================

// Retourner les actions avec support OU résistance niveau 3
screener[condition1 OR condition2] (supportLevel AS "Support N3", supportTouches AS "Touches Support", resistanceLevel AS "Résistance N3", resistanceTouches AS "Touches Résist")
