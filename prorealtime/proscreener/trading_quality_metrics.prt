// ProScreener: Métriques de Qualité de Trading + Multi-Timeframe
// Calcule diverses métriques pour évaluer la qualité d'un instrument pour le trading
// Compatible : Actions, Indices, Forex, Crypto
// Unité de temps recommandée : 1 minute (pour ATR 1m)
// VERSION 2.0 - Avec analyse multi-timeframe

// ============================================
// PARAMÈTRES
// ============================================
lookbackPeriod = 100     // Période d'analyse pour les calculs de moyenne
atrPeriod = 14           // Période pour l'ATR
vwapStart = 0            // Heure de début du VWAP (0 = début de journée)
minBodyRatio = 0.5       // Ratio minimum corps/bougie pour qualité
minVolRatio = 1.0        // Ratio minimum volume/moyenne pour qualité

// Paramètres Multi-Timeframe
enableMTF = 1            // 1 = activer multi-TF, 0 = désactiver
trendPeriod = 20         // Période pour calcul de tendance (EMA)

// ============================================
// 1. VOLUME / MINUTE (× moyenne)
// ============================================

// Calcul de la moyenne du volume sur la période
volumeAverage = AVERAGE[lookbackPeriod](volume)

// Ratio volume actuel / moyenne
IF volumeAverage > 0 THEN
    volumeRatio = volume / volumeAverage
ELSE
    volumeRatio = 0
ENDIF

// Indicateur : Volume supérieur à la moyenne
highVolume = volumeRatio >= minVolRatio

// ============================================
// 2. SPREAD RATIO (%)
// ============================================

// Approximation du spread via la range de la bougie
// Spread = (High - Low) / Close * 100
IF close > 0 THEN
    spreadRatio = ((high - low) / close) * 100
ELSE
    spreadRatio = 0
ENDIF

// Spread moyen sur la période
avgSpread = AVERAGE[lookbackPeriod](spreadRatio)

// Indicateur : Spread faible (bon pour le trading)
lowSpread = spreadRatio < avgSpread

// ============================================
// 3. ATR(1m) (× moyenne)
// ============================================

// Calcul de l'ATR
atrValue = AverageTrueRange[atrPeriod](close)

// Moyenne de l'ATR
atrAverage = AVERAGE[lookbackPeriod](atrValue)

// Ratio ATR actuel / moyenne
IF atrAverage > 0 THEN
    atrRatio = atrValue / atrAverage
ELSE
    atrRatio = 0
ENDIF

// ATR en % du prix (volatilité)
IF close > 0 THEN
    atrPercent = (atrValue / close) * 100
ELSE
    atrPercent = 0
ENDIF

// ============================================
// 4. RATIO CORPS / MÈCHE
// ============================================

// Taille du corps de la bougie
bodySize = ABS(close - open)

// Taille totale de la bougie (range)
candleRange = high - low

// Ratio corps / range
IF candleRange > 0 THEN
    bodyWickRatio = bodySize / candleRange
ELSE
    bodyWickRatio = 0
ENDIF

// Indicateur : Corps fort (bon signal directionnel)
strongBody = bodyWickRatio >= minBodyRatio

// ============================================
// 5. CHEVAUCHEMENT CORPS (%)
// ============================================

// Corps de la bougie actuelle
currentBodyHigh = MAX(close, open)
currentBodyLow = MIN(close, open)

// Corps de la bougie précédente
prevBodyHigh = MAX(close[1], open[1])
prevBodyLow = MIN(close[1], open[1])

// Calcul du chevauchement
overlapHigh = MIN(currentBodyHigh, prevBodyHigh)
overlapLow = MAX(currentBodyLow, prevBodyLow)
overlapSize = MAX(0, overlapHigh - overlapLow)

// Taille du corps précédent
prevBodySize = ABS(close[1] - open[1])

// Pourcentage de chevauchement
IF prevBodySize > 0 THEN
    bodyOverlapPercent = (overlapSize / prevBodySize) * 100
ELSE
    bodyOverlapPercent = 0
ENDIF

// ============================================
// 6. RUN DIRECTIONNEL RÉCENT
// ============================================

// Compter les bougies haussières consécutives
bullishRun = 0
FOR i = 0 TO 9 DO
    IF close[i] > open[i] THEN
        bullishRun = bullishRun + 1
    ELSE
        BREAK
    ENDIF
NEXT

// Compter les bougies baissières consécutives
bearishRun = 0
FOR i = 0 TO 9 DO
    IF close[i] < open[i] THEN
        bearishRun = bearishRun + 1
    ELSE
        BREAK
    ENDIF
NEXT

// Run directionnel maximum (absolu)
directionalRun = MAX(bullishRun, bearishRun)

// Indicateur : Run directionnel présent (3+ bougies)
hasDirectionalRun = directionalRun >= 3

// ============================================
// 7. VWAP ET ZONES
// ============================================

// Calcul du VWAP depuis le début de la journée
ONCE sumPV = 0
ONCE sumV = 0

IF time >= vwapStart OR dayofweek <> dayofweek[1] THEN
    startVWAP = 1
    sumPV = 0
    sumV = 0
ENDIF

IF startVWAP THEN
    sumPV = sumPV + (close * volume)
    sumV = sumV + volume
    IF sumV > 0 THEN
        vwap = sumPV / sumV
    ELSE
        vwap = close
    ENDIF
ELSE
    vwap = close
ENDIF

// Distance au VWAP en %
IF vwap > 0 THEN
    distanceToVWAP = ((close - vwap) / vwap) * 100
ELSE
    distanceToVWAP = 0
ENDIF

// Indicateur : Respecte le VWAP (proche à +/- 0.5%)
respectsVWAP = ABS(distanceToVWAP) <= 0.5

// Position par rapport au VWAP
aboveVWAP = close > vwap
belowVWAP = close < vwap

// ============================================
// 8. SLIPPAGE / ATR APPROXIMÉ
// ============================================

// Slippage approximé comme % de l'ATR
// Utilise le spread comme proxy du slippage potentiel
IF atrValue > 0 THEN
    slippageRatio = spreadRatio / atrPercent
ELSE
    slippageRatio = 0
ENDIF

// Indicateur : Slippage faible (< 10% de l'ATR)
lowSlippage = slippageRatio < 0.1

// ============================================
// 9. INDICATEURS DE QUALITÉ SUPPLÉMENTAIRES
// ============================================

// Vitesse du flux (régularité du volume)
// Écart-type du volume (plus faible = plus régulier)
volumeStdDev = STD[20](volume)
IF volumeAverage > 0 THEN
    volumeCV = volumeStdDev / volumeAverage
ELSE
    volumeCV = 0
ENDIF

// Indicateur : Flux régulier (coefficient de variation < 0.5)
regularFlow = volumeCV < 0.5

// ============================================
// 10. ANALYSE MULTI-TIMEFRAME (NOUVEAU)
// ============================================

IF enableMTF = 1 THEN

    // ===== TIMEFRAME ACTUEL =====
    // EMA pour déterminer la tendance
    ema_current = ExponentialAverage[trendPeriod](close)

    // Direction de la tendance actuelle
    IF close > ema_current THEN
        trend_current = 1      // Haussier
    ELSIF close < ema_current THEN
        trend_current = -1     // Baissier
    ELSE
        trend_current = 0      // Neutre
    ENDIF

    // Force de la tendance actuelle (distance à l'EMA en %)
    IF ema_current > 0 THEN
        trendStrength_current = ((close - ema_current) / ema_current) * 100
    ELSE
        trendStrength_current = 0
    ENDIF


    // ===== TIMEFRAME SUPÉRIEUR 1 (5 min si on est en 1 min) =====
    // Récupération des données du TF supérieur
    close_tf2 = TIMEFRAME(5 minutes, close)
    ema_tf2 = TIMEFRAME(5 minutes, ExponentialAverage[trendPeriod](close))

    // Direction de la tendance TF2
    IF close_tf2 > ema_tf2 THEN
        trend_tf2 = 1          // Haussier
    ELSIF close_tf2 < ema_tf2 THEN
        trend_tf2 = -1         // Baissier
    ELSE
        trend_tf2 = 0          // Neutre
    ENDIF

    // Force de la tendance TF2
    IF ema_tf2 > 0 THEN
        trendStrength_tf2 = ((close_tf2 - ema_tf2) / ema_tf2) * 100
    ELSE
        trendStrength_tf2 = 0
    ENDIF


    // ===== TIMEFRAME SUPÉRIEUR 2 (15 min si on est en 1 min) =====
    // Récupération des données du TF supérieur
    close_tf3 = TIMEFRAME(15 minutes, close)
    ema_tf3 = TIMEFRAME(15 minutes, ExponentialAverage[trendPeriod](close))

    // Direction de la tendance TF3
    IF close_tf3 > ema_tf3 THEN
        trend_tf3 = 1          // Haussier
    ELSIF close_tf3 < ema_tf3 THEN
        trend_tf3 = -1         // Baissier
    ELSE
        trend_tf3 = 0          // Neutre
    ENDIF

    // Force de la tendance TF3
    IF ema_tf3 > 0 THEN
        trendStrength_tf3 = ((close_tf3 - ema_tf3) / ema_tf3) * 100
    ELSE
        trendStrength_tf3 = 0
    ENDIF


    // ===== ANALYSE DE L'ALIGNEMENT =====

    // Compteur d'alignement haussier
    bullishAlign = 0
    IF trend_current = 1 THEN
        bullishAlign = bullishAlign + 1
    ENDIF
    IF trend_tf2 = 1 THEN
        bullishAlign = bullishAlign + 1
    ENDIF
    IF trend_tf3 = 1 THEN
        bullishAlign = bullishAlign + 1
    ENDIF

    // Compteur d'alignement baissier
    bearishAlign = 0
    IF trend_current = -1 THEN
        bearishAlign = bearishAlign + 1
    ENDIF
    IF trend_tf2 = -1 THEN
        bearishAlign = bearishAlign + 1
    ENDIF
    IF trend_tf3 = -1 THEN
        bearishAlign = bearishAlign + 1
    ENDIF

    // Alignement total (3 TF dans la même direction)
    trendAligned = (bullishAlign = 3) OR (bearishAlign = 3)

    // Alignement partiel (2 TF sur 3)
    trendPartialAlign = (bullishAlign >= 2) OR (bearishAlign >= 2)

    // Divergence (tendances opposées)
    trendDivergence = (bullishAlign >= 1 AND bearishAlign >= 1)

    // Score d'alignement (0-3)
    alignmentScore = MAX(bullishAlign, bearishAlign)

    // Force moyenne de la tendance multi-TF
    avgTrendStrength = (ABS(trendStrength_current) + ABS(trendStrength_tf2) + ABS(trendStrength_tf3)) / 3

    // Indicateurs de confirmation
    strongTrendAlignment = trendAligned AND avgTrendStrength > 0.5
    moderateTrendAlignment = trendPartialAlign AND avgTrendStrength > 0.3

ELSE
    // Si multi-TF désactivé
    trend_current = 0
    trend_tf2 = 0
    trend_tf3 = 0
    trendAligned = 0
    trendPartialAlign = 0
    trendDivergence = 0
    alignmentScore = 0
    avgTrendStrength = 0
    strongTrendAlignment = 0
    moderateTrendAlignment = 0
    trendStrength_current = 0
    trendStrength_tf2 = 0
    trendStrength_tf3 = 0
ENDIF

// ============================================
// 11. SCORE DE QUALITÉ GLOBAL (AMÉLIORÉ)
// ============================================

// Calcul du score de base (0-10)
qualityScore = 0

// +1 pour chaque critère rempli
IF highVolume THEN
    qualityScore = qualityScore + 1
ENDIF

IF lowSpread THEN
    qualityScore = qualityScore + 1
ENDIF

IF strongBody THEN
    qualityScore = qualityScore + 1
ENDIF

IF hasDirectionalRun THEN
    qualityScore = qualityScore + 1
ENDIF

IF respectsVWAP THEN
    qualityScore = qualityScore + 1
ENDIF

IF lowSlippage THEN
    qualityScore = qualityScore + 1
ENDIF

IF regularFlow THEN
    qualityScore = qualityScore + 1
ENDIF

IF atrRatio >= 0.8 AND atrRatio <= 1.2 THEN
    qualityScore = qualityScore + 1
ENDIF

IF bodyOverlapPercent >= 30 AND bodyOverlapPercent <= 70 THEN
    qualityScore = qualityScore + 1
ENDIF

IF volumeRatio >= 1.5 THEN
    qualityScore = qualityScore + 1
ENDIF

// Bonus Multi-Timeframe (jusqu'à +3 points)
IF enableMTF = 1 THEN
    // +2 si alignement parfait (3 TF)
    IF strongTrendAlignment THEN
        qualityScore = qualityScore + 2
    // +1 si alignement partiel (2 TF)
    ELSIF moderateTrendAlignment THEN
        qualityScore = qualityScore + 1
    ENDIF

    // +1 si forte tendance moyenne
    IF avgTrendStrength > 1.0 THEN
        qualityScore = qualityScore + 1
    ENDIF
ENDIF

// Score maximum = 13 avec multi-TF, 10 sans

// ============================================
// 12. CONDITIONS DU SCREENER (AMÉLIORÉES)
// ============================================

// Chercher les instruments de haute qualité (score >= 7)
highQuality = qualityScore >= 7

// Signal directionnel haussier (avec confirmation MTF)
IF enableMTF = 1 THEN
    bullishSignal = highQuality AND bullishRun >= 3 AND aboveVWAP AND (trend_tf2 = 1 OR trend_tf3 = 1)
    bearishSignal = highQuality AND bearishRun >= 3 AND belowVWAP AND (trend_tf2 = -1 OR trend_tf3 = -1)
ELSE
    bullishSignal = highQuality AND bullishRun >= 3 AND aboveVWAP
    bearishSignal = highQuality AND bearishRun >= 3 AND belowVWAP
ENDIF

// Signal ultra-fort (alignement complet)
ultraBullish = bullishSignal AND trendAligned AND bullishAlign = 3
ultraBearish = bearishSignal AND trendAligned AND bearishAlign = 3

// Alerte divergence (attention)
divergenceAlert = highQuality AND trendDivergence

// Condition principale : Qualité élevée OU signal directionnel
c1 = highQuality OR bullishSignal OR bearishSignal

// ============================================
// 13. SCREENER OUTPUT
// ============================================

SCREENER[c1](
    qualityScore AS "Score",
    volumeRatio AS "Vol/Moy",
    spreadRatio AS "Spread%",
    atrRatio AS "ATR/Moy",
    bodyWickRatio * 100 AS "Corps%",
    directionalRun AS "Run",
    distanceToVWAP AS "VWAP%",
    alignmentScore AS "Align",
    trend_current AS "T1m",
    trend_tf2 AS "T5m",
    trend_tf3 AS "T15m"
)
